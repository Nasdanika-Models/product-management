<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.nasdanika.models.product-management</groupId>
        <version>2026.6.0</version>
        <artifactId>parent</artifactId>
        <relativePath>..</relativePath>
    </parent>
    <artifactId>groovy-dsl</artifactId>
    <packaging>jar</packaging>
    <name>Product Management Groovy DSL</name>
    <description>Groovy DSL builders and scripting source handler for authoring Product Management models in Groovy</description>

    <properties>
        <!-- Groovy 5.0.x requires JDK 11+; this build targets JDK 21 (see parent). -->
        <groovy.version>5.0.6</groovy.version>
        <gmavenplus.version>4.3.1</gmavenplus.version>
    </properties>

    <dependencies>
        <!-- The generated EMF model: ProductModel, Concern, Capability, ... (brings capability + EMF transitively) -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>model</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- Groovy itself - the DSL builders compile against it -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy</artifactId>
            <version>${groovy.version}</version>
        </dependency>
        <!-- JSR-223 engine used by the .groovy source handler at runtime -->
        <dependency>
            <groupId>org.apache.groovy</groupId>
            <artifactId>groovy-jsr223</artifactId>
            <version>${groovy.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Groovy compilation: src/main/groovy -> target/classes/*.class (ordinary classpath classes) -->
            <plugin>
                <groupId>org.codehaus.gmavenplus</groupId>
                <artifactId>gmavenplus-plugin</artifactId>
                <version>${gmavenplus.version}</version>
                <configuration>
                    <targetBytecode>21</targetBytecode>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>addSources</goal>
                            <goal>addTestSources</goal>
                            <goal>compile</goal>
                            <goal>compileTests</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Treat this Groovy-only jar as an automatic JPMS module so the Java handlers module can require it -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>org.nasdanika.models.productmanagement.dsl.groovy</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
