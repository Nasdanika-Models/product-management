@Ecore(nsURI="https://product-management.models.nasdanika.org", nsPrefix="org.nasdanika.models.product-management")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.productmanagement

import org.nasdanika.models.productmanagement.ProductmanagementPackage
import org.eclipse.emf.ecore.EObject

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

type Instant wraps java.time.Instant
type Duration wraps java.time.Duration 

interface Referrable {
    
    op void collect(
            Object source,
            org.eclipse.emf.ecore.EReference eReference,
            EObject[] accumulator) {
        if (eReference.EContainingClass.isInstance(source)) {
            val value = (source as org.eclipse.emf.ecore.EObject).eGet(eReference)
            if (eReference.many) {
                if ((value as java.util.Collection<?>).contains(this)) {
                    accumulator.add(source as org.eclipse.emf.ecore.EObject)
                }
            } else if (value === this) {
                accumulator.add(source as org.eclipse.emf.ecore.EObject)
            }
        }
    }    
    
    op EObject[] getReferrers(org.eclipse.emf.ecore.EReference eReference) {
        val ret = new org.eclipse.emf.common.util.BasicEList<EObject>()
        
        val org.eclipse.emf.ecore.resource.Resource res = this.eResource()
        var org.eclipse.emf.common.util.TreeIterator<?> cit = null
        
        if (res === null) {
            var org.eclipse.emf.ecore.EObject root = this
            var org.eclipse.emf.ecore.EObject rc
            while ((rc = root.eContainer()) !== null) {
                root = rc
            }
            if (root !== null) {
                collect(root, eReference, ret)
                cit = root.eAllContents()
            }
        } else {
            val rSet = res.resourceSet
            cit = if (rSet === null) res.allContents else rSet.allContents
        }
        
        if (cit !== null) {
            while (cit.hasNext()) {
                collect(cit.next(), eReference, ret)
            }
        }
        
        return ret
    }    
    
}

class Temporal {
    
    refers Temporal base
    
    Instant instant
    
    Duration duration
    
    refers Temporal[] lowerBounds
    
    refers Temporal[] upperBounds
    
    // TODO - operations - after, before, normalize, minus, plus, copy, conicides
        
}

class Period {
    
    Duration duration
    
    contains Temporal start
    
    contains Temporal end
    
}

interface StringIdentity extends Referrable {
    
    String ^id
    
}

abstract class ModelElement extends StringIdentity {

// id, documentation, uris - aliases

    String documentation
    
    /**
     * Documentation resource URI resolved relative to this model element resource URI.
     * Documentation format is derived from extension if not set.
     */
    String docRef
    
    /**
     * Documentation format. If not set, defaults to markdown for inline documentation and is
     * derived from the documentation resource extension for docRef 
     */
    String docFormat
    
    /**
     * Alias URIs resolved relative to the parent URIs - can be absolute or opaque - global references. 
     * For example: actors://john-smith.
     * For domains URIs can be used as anchors to merge domains from different sources.
     * For example, several teams may maintain capability domains with URI myorg://capabilities/developer-productivity
     * When these definitions are assembled into the organization's product management model to generate documentation
     * all of these domains are merged into a single logical domain.
     */
    String[] uris
    
    /**
     * Extension-specific configuration associated with a model element.
     * For example, geometry and color for a diagram facet,
     * Weight for a prioritization facet.
     */
    // contains EObject[] facets

}

abstract class NamedElement extends ModelElement {
    
    String name
    
}

abstract class NamedPeriod extends NamedElement, Period {


}

class ProductModel extends 
    NamedPeriod, 
    PersonaDomain, 
    CapabilityDomain, 
    CapabilityProviderDomain,
    ActorDomain {
        
}

interface AbstractPersona extends ModelElement {
    
} 

class Persona extends NamedPeriod, AbstractPersona, ConcernDomain {
    
}

class PersonaDomain extends NamedElement, AbstractPersona {
    
    @Nasdanika(logicalContainment="false")         
    contains AbstractPersona[] personas keys ^id
    
    @Nasdanika(logicalContainment="true")         
    refers derived transient volatile readonly AbstractPersona[] resolvedPersonas keys ^id get {
        val result = new org.eclipse.emf.common.util.BasicEList<AbstractPersona>()
        for (persona : personas) {
            val resolved = resolvePersonaReference(persona)
            if (resolved !== null) result.add(resolved)
        }
        result
    }
    
    op AbstractPersona resolvePersonaReference(AbstractPersona start) {
        var AbstractPersona current = start
        val seen = new java.util.HashSet<AbstractPersona>()
        while (current instanceof PersonaReference) {
            if (!seen.add(current)) {
                return null  // cycle detected
            }
            current = current.target
            if (current === null) return null  // dangling reference
        }
        return current
    }    
        
}

class PersonaReference extends AbstractPersona {
    
    refers Persona target    
}

interface AbstractConcern extends ModelElement {
    
}

class Concern extends NamedPeriod, AbstractConcern {
    
    /**
     * Addressed by allows to explain how some external capabilities address
     * concerns. 
     * It also allows to model capabilities within concerns to have a 
     * self-contained persona. 
     * It can be used in acquisition/unification scenarios
     * where shared capabilities are extracted (e.g. accounting or a custom script/tool)
     * and unique are retained (e.g. the best clam chowder in town, report generation)
     */
    contains AbstractCapability[] addressedBy
    
    /**
     * Addressed concerns from this capability plus addressedBy from concerns
     */
    refers derived transient volatile readonly AbstractCapability[] allAddressedBy get {
        val result = new org.eclipse.emf.common.util.BasicEList<AbstractCapability>()
        result.addAll(addressedBy)
        for (referrer : getReferrers(ProductmanagementPackage.Literals.CAPABILITY__ADDRESSES)) {
            if (referrer instanceof AbstractCapability) {
                result.add(referrer)
            }
        }
        result
    }    
            
}

class ConcernReference extends AbstractConcern {
    
    //@Nasdanika(logicalContainment="true")         
    refers Concern target
    
}

class ConcernDomain extends NamedElement, AbstractConcern {
    
    @Nasdanika(logicalContainment="false")         
    contains AbstractConcern[] concerns keys ^id
    
    @Nasdanika(logicalContainment="true")         
    refers derived transient volatile readonly AbstractConcern[] resolvedConcerns keys ^id get {
        val result = new org.eclipse.emf.common.util.BasicEList<AbstractConcern>()
        for (concern : concerns) {
            val resolved = resolveConcernReference(concern)
            if (resolved !== null) result.add(resolved)
        }
        result
    }
    
    op AbstractConcern resolveConcernReference(AbstractConcern start) {
        var AbstractConcern current = start
        val seen = new java.util.HashSet<AbstractConcern>()
        while (current instanceof ConcernReference) {
            if (!seen.add(current)) {
                return null  // cycle detected
            }
            current = current.target
            if (current === null) return null  // dangling reference
        }
        return current
    }    
    
}

class Goal extends Concern {
    
    /**
     * References to needs supporting this goal
     */
    refers ConcernReference[] supportedBy
    
    /**
     * Supporting needs from this goal plus supports from needs
     */
    refers derived transient volatile readonly Need[] allSupportedBy get {
        val result = new org.eclipse.emf.common.util.BasicEList<Need>()
        for (ref : supportedBy) {
            var target = ref.target
            if (target instanceof Need) {
                result.add(target)
            }
        }
        
        for (referrer : getReferrers(ProductmanagementPackage.Literals.NEED__SUPPORTS)) {
            if (referrer instanceof Need) {
                result.add(referrer)
            }
        }
        result
    }    
        
    /**
     * References to pain points blocking this goal
     */
    refers ConcernReference[] blockedBy
    
    /**
     * BlockedBy from this goal plus blocks from pain points
     */
    refers derived transient volatile readonly PainPoint[] allBlockedBy get {
        val result = new org.eclipse.emf.common.util.BasicEList<PainPoint>()
        for (ref : blockedBy) {
            var target = ref.target
            if (target instanceof PainPoint) {
                result.add(target)
            }
        }
        
        for (referrer : getReferrers(ProductmanagementPackage.Literals.PAIN_POINT__BLOCKS)) {
            if (referrer instanceof PainPoint) {
                result.add(referrer)
            }
        }
        result
    }    
    
}

class Need extends Concern {
    
    /**
     * Goals supported by this need
     */
    contains ConcernReference[] supports
    
    /**
     * Supports from this need plus supportingNeeds from goals
     */
    refers derived transient volatile readonly Goal[] allSupports get {
        val result = new org.eclipse.emf.common.util.BasicEList<Goal>()
        for (ref : supports) {
            var target = ref.target
            if (target instanceof Goal) {
                result.add(target)
            }
        }
        
        for (referrer : getReferrers(ProductmanagementPackage.Literals.GOAL__SUPPORTED_BY)) {
            if (referrer instanceof Goal) {
                result.add(referrer)
            }
        }
        result
    }    
    
    /**
     * References to pain points violating this need
     * with an optional documentation explaining
     * how the need is violated
     */
    contains ConcernReference[] violatedBy
        
    /**
     * ViolatedBy from this need plus violates from pain points
     */
    refers derived transient volatile readonly PainPoint[] allViolatedBy get {
        val result = new org.eclipse.emf.common.util.BasicEList<PainPoint>()
        for (ref : violatedBy) {
            var target = ref.target
            if (target instanceof PainPoint) {
                result.add(target)
            }
        }
        for (referrer : getReferrers(ProductmanagementPackage.Literals.PAIN_POINT__VIOLATES)) {
            if (referrer instanceof PainPoint) {
                result.add(referrer)
            }
        }
        result
    }        
    
}

class PainPoint extends Concern {
    
    contains ConcernReference[] blocks
    
    /**
     * Blocks from this pain point plus blockers from pain points
     */
    refers derived transient volatile readonly Goal[] allBlocks get {
        val result = new org.eclipse.emf.common.util.BasicEList<Goal>()
        for (ref : blocks) {
            var target = ref.target
            if (target instanceof Goal) {
                result.add(target)
            }
        }
        
        for (referrer : getReferrers(ProductmanagementPackage.Literals.GOAL__BLOCKED_BY)) {
            if (referrer instanceof Goal) {
                result.add(referrer)
            }
        }
        result
    }        
    
    contains ConcernReference[] violates
            
    /**
     * Blocks from this pain point plus blockers from pain points
     */
    refers derived transient volatile readonly Need[] allViolates get {
        val result = new org.eclipse.emf.common.util.BasicEList<Need>()
        for (ref : violates) {
            var target = ref.target
            if (target instanceof Need) {
                result.add(target)
            }
        }
        
        for (referrer : getReferrers(ProductmanagementPackage.Literals.NEED__VIOLATED_BY)) {
            if (referrer instanceof Need) {
                result.add(referrer)
            }
        }
        result
    }            
    
}

// --- Capabilities ---

enum Lifecycle {
    DRAFT       as "Draft"    = 0
    PROPOSED    as "Proposed"    = 100
    BACKLOG     as "Backlog"     = 200
    PLANNED     as "Planned"     = 300
    IN_PROGRESS as "In Progress" = 400
    AVAILABLE   as "Available"   = 500
    DEPRECATED  as "Deprecated"  = 600
    RETIRED     as "Retired"     = 700
}

interface AbstractCapability extends ModelElement {
    
}

/**
 * A capability extends PersonaDomain, ConcernDomain, and EvidenceDomain
 * to support self-contained capability definitions. A capability may:
 *  - address concerns owned by external personas or other capabilities
 *    (via AddressedConcerns)
 *  - introduce capability-specific personas (via PersonaDomain)
 *  - introduce concerns that exist by virtue of the capability itself,
 *    not owned by any persona (via ConcernDomain)
 *  - carry the evidence supporting all of the above (via EvidenceDomain)
 *  - decompose into sub-capabilities (via subCapabilities)
 */
class Capability extends 
    NamedPeriod, 
    AbstractCapability, 
    EvidenceDomain, 
    PersonaDomain, 
    ConcernDomain {
    
    contains AbstractConcern[] addresses

    /**
     * Addressed concerns from this capability plus addressedBy from concerns
     */
    refers derived transient volatile readonly AbstractConcern[] allAddresses get {
        val result = new org.eclipse.emf.common.util.BasicEList<AbstractConcern>()
        result.addAll(addresses)
        for (referrer : getReferrers(ProductmanagementPackage.Literals.CONCERN__ADDRESSED_BY)) {
            if (referrer instanceof AbstractConcern) {
                result.add(referrer)
            }
        }
        result
    }
    
    contains AbstractCapability[] subCapabilities keys ^id  // composition
    
    /**
     * Dependencies as an abstract capability allows to 
     * model self-contained capabilities with inline dependencies
     * and even dependency domains.
     * When federated, such inline capabilities can be 
     * either replaced with CapabilityReference or CapabilityDependency
     * or use URIs to de-dup multiple definitions into one logical definition
     */
    contains AbstractCapability[] dependencies
    
    /**
     * Capabilities depending on this capability, excludes containment. 
     * Returns capability references, including capability dependencies, with target pointing
     * to this capability and contained by the dependencies reference.  
     */
    refers derived transient volatile readonly CapabilityReference[] dependents get {
        val result = new org.eclipse.emf.common.util.BasicEList<CapabilityReference>()
        for (referrer : getReferrers(ProductmanagementPackage.Literals.CAPABILITY_REFERENCE__TARGET)) {
            if (referrer.eContainmentFeature() === ProductmanagementPackage.Literals.CAPABILITY__DEPENDENCIES) {
                if (referrer instanceof CapabilityReference) {
                    result.add(referrer)
                }                
            }
        }
        result
    }    
    
    Lifecycle lifecycle
        
}

/**
 * Capability reference extends ModelEment to allow adding documentation
 * to addressedBy
 */
class CapabilityReference extends ModelElement, AbstractCapability {
    
    //@Nasdanika(logicalContainment="true")         
    refers Capability target
        
}

class CapabilityDomain extends NamedElement, AbstractCapability {
    
    @Nasdanika(logicalContainment="false")         
    contains AbstractCapability[] capabilities keys ^id
       
    @Nasdanika(logicalContainment="true")         
    refers derived transient volatile readonly AbstractCapability[] resolvedCapabilities keys ^id get {
        val result = new org.eclipse.emf.common.util.BasicEList<AbstractCapability>()
        for (capability : capabilities) {
            val resolved = resolveCapabilityReference(capability)
            if (resolved !== null) result.add(resolved)
        }
        result
    }
    
    op AbstractCapability resolveCapabilityReference(AbstractCapability start) {
        var AbstractCapability current = start
        val seen = new java.util.HashSet<AbstractCapability>()
        while (current instanceof CapabilityReference) {
            if (!seen.add(current)) {
                return null  // cycle detected
            }
            current = current.target
            if (current === null) return null  // dangling reference
        }
        return current
        
    }
    
}

class CapabilityDependency extends CapabilityReference {
    
    DependencyKind kind  // PREREQUISITE, ENHANCES, CONFLICTS_WITH
    boolean optional
    
}

enum DependencyKind {
    PREREQUISITE  // I cannot function without this
    ENHANCES      // I work better when this is also present
    CONFLICTS     // I cannot coexist with this
}

// --- Capability Providers ---

interface AbstractCapabilityProvider extends StringIdentity {
    
}

class CapabilityProvider extends NamedPeriod, AbstractCapabilityProvider {
    
    contains ProvidedCapability[] provides
    
    contains RequiredCapability[] requires    
        
    Lifecycle lifecycle    
    
}

class CapabilityProviderDomain extends NamedElement, AbstractCapabilityProvider {
    
    contains AbstractCapabilityProvider[] capabilityProviders
    
}

class CapabilityProviderReference extends AbstractCapabilityProvider {
    refers CapabilityProvider target
}

class ProvidedCapability extends NamedPeriod, EvidenceDomain {
    
    contains AbstractCapability capability
        
}

interface AbstractEvidence extends StringIdentity {
    
}

/**
 * Evidence of provided capability.
 * E.g. for humans it can be a diploma or a certification or a project
 * For software products it might be a demo, recorded video, ...
 */
class Evidence extends NamedPeriod, AbstractEvidence {
    
}

class EvidenceDomain extends NamedElement, AbstractEvidence {
    
    contains Evidence[] evidence keys ^id
    
}

class RequiredCapability extends NamedPeriod {
    
    contains AbstractCapability capability
    
}

// --- Version ---

class Version extends NamedPeriod {
    
}

// --- Undergoer, actor, role ---

interface Undergoer {
    
    contains Role[] roles
    
}

class Role extends NamedPeriod {
    
    contains RoleAssignment[] assignments 
    
}

class RoleAssignment extends Period {
    
    String comment
    
    contains AbstractActor actors
    
}

interface AbstractActor extends StringIdentity {
    
}

class Actor extends NamedPeriod, AbstractActor {
    
}

class ActorDomain extends NamedElement, AbstractActor {
    
    contains AbstractActor[] actors
    
}

