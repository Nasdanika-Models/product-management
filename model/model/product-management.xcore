@Ecore(nsURI="https://product-management.models.nasdanika.org", nsPrefix="org.nasdanika.models.product-management")
@GenModel(
    featureDelegation="Dynamic",
    complianceLevel="21.0",
    suppressGenModelAnnotations="false",
    copyrightFields="false",
    operationReflection="true",
    importOrganizing="true"
)
package org.nasdanika.models.productmanagement

annotation "http://www.eclipse.org/emf/2002/Ecore" as Ecore
annotation "http://www.eclipse.org/emf/2002/GenModel" as GenModel
annotation "urn:org.nasdanika" as Nasdanika

type Instant wraps java.time.Instant
type Duration wraps java.time.Duration 

class Temporal {
    
    refers Temporal base
    
    Instant instant
    
    Duration duration
    
    refers Temporal[] lowerBounds
    
    refers Temporal[] upperBounds
    
    // TODO - operations - after, before, normalize, minus, plus, copy, conicides
        
}

class Period {
    
    Duration duration
    
    contains Temporal start
    
    contains Temporal end
    
}

interface StringIdentity {
    
    String ^id
    
}

abstract class ModelElement extends StringIdentity {

// id, documentation, uris - aliases

    String documentation
    
    /**
     * Alias URIs resolved relative to the parent URIs - can be absolute or opaque - global references. 
     * For example: actors://john-smith.
     * For domains URIs can be used as anchors to merge domains from different sources.
     * For example, several teams may maintain capability domains with URI myorg://capabilities/developer-productivity
     * When these definitions are assembled into the organization's product management model to generate documentation
     * all of these domains are merged into a single logical domain.
     */
    String[] uris

}

abstract class NamedElement extends ModelElement {
    
    String name
    
}

abstract class NamedPeriod extends NamedElement, Period {


}

class ProductModel extends 
    NamedPeriod, 
    PersonaDomain, 
    CapabilityDomain, 
    CapabilityProviderDomain,
    ActorDomain {
    
    
}

interface AbstractPersona extends StringIdentity {
    
} 

class Persona extends NamedPeriod, AbstractPersona, ConcernDomain {
    
}

interface PersonaDomain extends NamedElement, AbstractPersona {
    
    @Nasdanika(logicalContainment="false")         
    contains AbstractPersona[] personas keys ^id
    
    @Nasdanika(logicalContainment="true")         
    refers derived transient volatile readonly AbstractPersona[] resolvedPersonas keys ^id get {
        val result = new org.eclipse.emf.common.util.BasicEList<AbstractPersona>()
        for (persona : personas) {
            val resolved = resolveReference(persona)
            if (resolved !== null) result.add(resolved)
        }
        result
    }
    
    op AbstractPersona resolveReference(AbstractPersona start) {
        var AbstractPersona current = start
        val seen = new java.util.HashSet<AbstractPersona>()
        while (current instanceof PersonaReference) {
            if (!seen.add(current)) {
                return null  // cycle detected
            }
            current = (current as PersonaReference).target
            if (current === null) return null  // dangling reference
        }
        return current
    }    
        
}

class PersonaReference extends AbstractPersona {
    
    refers Persona target    
}

interface AbstractConcern extends StringIdentity {
    
}

class Concern extends NamedPeriod, AbstractConcern {
    
    /**
     * Addressed by allows to explain how some external capabilities address
     * concerns. 
     * It also allows to model capabilities within concerns to have a 
     * self-contained persona. 
     * It can be used in acquisition/unification scenarios
     * where shared capabilities are extracted (e.g. accounting or a custom script/tool)
     * and unique are retained (e.g. the best clam chowder in town, report generation)
     */
    contains AbstractCapability[] addressedBy
            
}

class ConcernReference extends AbstractConcern {
    
    @Nasdanika(logicalContainment="true")         
    refers Concern target
    
}

interface ConcernDomain extends AbstractConcern {
    
    contains AbstractConcern[] concerns keys ^id
    
}

class Goal extends Concern {
    
    refers SupportedGoals[] supportingNeeds opposite goals
    
    refers BlockedGoals[] blockers opposite goals
    
}

class Need extends Concern {
    
    contains SupportedGoals[] supports
    
    refers ViolatedNeeds[] violators opposite needs
    
}

class SupportedGoals extends ModelElement {
    
    refers Goal[1..*] goals opposite supportingNeeds
    
}

class PainPoint extends Concern {
    
    contains BlockedGoals[] blocks
    
    contains ViolatedNeeds[] violates        
    
}

class BlockedGoals extends ModelElement {
    
    refers Goal[1..*] goals opposite blockers
    
}

class ViolatedNeeds extends ModelElement {
    
    refers Need[1..*] needs opposite violators
    
}

// --- Capabilities ---

enum Lifecycle {
    DRAFT       as "Draft"    = 0
    PROPOSED    as "Proposed"    = 100
    BACKLOG     as "Backlog"     = 200
    PLANNED     as "Planned"     = 300
    IN_PROGRESS as "In Progress" = 400
    AVAILABLE   as "Available"   = 500
    DEPRECATED  as "Deprecated"  = 600
    RETIRED     as "Retired"     = 700
}

interface AbstractCapability extends StringIdentity {
    
}

/**
 * A capability extends PersonaDomain, ConcernDomain, and EvidenceDomain
 * to support self-contained capability definitions. A capability may:
 *  - address concerns owned by external personas or other capabilities
 *    (via AddressedConcerns)
 *  - introduce capability-specific personas (via PersonaDomain)
 *  - introduce concerns that exist by virtue of the capability itself,
 *    not owned by any persona (via ConcernDomain)
 *  - carry the evidence supporting all of the above (via EvidenceDomain)
 *  - decompose into sub-capabilities (via subCapabilities)
 */
class Capability extends 
    NamedPeriod, 
    AbstractCapability, 
    EvidenceDomain, 
    PersonaDomain, 
    ConcernDomain {
    
    contains AddressedConcerns[] addresses
            
    contains AbstractCapability[] subCapabilities keys ^id  // composition
    
    Lifecycle lifecycle
        
}

class CapabilityReference extends AbstractCapability {
    
    @Nasdanika(logicalContainment="true")         
    refers Capability target
        
}

interface CapabilityDomain extends NamedElement, AbstractCapability {
    contains AbstractCapability[] capabilities
}

class AddressedConcerns extends ModelElement {
    
    refers Concern[1..*] concerns
    
}

class CapabilityDependency extends ModelElement {
    refers Capability[1..*] capabilities
    DependencyKind kind  // PREREQUISITE, ENHANCES, CONFLICTS_WITH
    boolean optional
}

enum DependencyKind {
    PREREQUISITE  // I cannot function without this
    ENHANCES      // I work better when this is also present
    CONFLICTS     // I cannot coexist with this
}

// --- Capability Providers ---

interface AbstractCapabilityProvider extends StringIdentity {
    
}

class CapabilityProvider extends NamedPeriod, AbstractCapabilityProvider {
    
    contains ProvidedCapability[] provides
    
    contains RequiredCapability[] requires    
        
    Lifecycle lifecycle    
    
}

interface CapabilityProviderDomain extends NamedElement, AbstractCapabilityProvider {
    
    contains AbstractCapabilityProvider[] capabilityProviders
    
}

class CapabilityProviderReference extends AbstractCapabilityProvider {
    refers CapabilityProvider target
}

class ProvidedCapability extends NamedPeriod, EvidenceDomain {
    
    contains AbstractCapability capability
        
}

interface AbstractEvidence extends StringIdentity {
    
}

/**
 * Evidence of provided capability.
 * E.g. for humans it can be a diploma or a certification or a project
 * For software products it might be a demo, recorded video, ...
 */
class Evidence extends NamedPeriod, AbstractEvidence {
    
}

interface EvidenceDomain extends NamedElement, AbstractEvidence {
    
    contains Evidence[] evidence keys ^id
    
}

class RequiredCapability extends NamedPeriod {
    
    contains AbstractCapability capability
    
}

// --- Version ---

class Version extends NamedPeriod {
    
}

// --- Undergoer, actor, role ---

interface Undergoer {
    
    contains Role[] roles
    
}

class Role extends NamedPeriod {
    
    contains RoleAssignment[] assignments 
    
}

class RoleAssignment extends Period {
    
    String comment
    
    contains AbstractActor actors
    
}

interface AbstractActor extends StringIdentity {
    
}

class Actor extends NamedPeriod, AbstractActor {
    
}

class ActorDomain extends NamedElement, AbstractActor {
    
    contains AbstractActor[] actors
    
}

